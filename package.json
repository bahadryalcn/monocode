{
  "name": "monocode-desktop",
  "private": true,
  "version": "0.9.1",
  "type": "module",
  "packageManager": "pnpm@12.8.2",
  "scripts": {
    "dev": "vite",
    "dev:stable": "vite --mode stable",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "host:build": "tsc --noEmit -p host/tsconfig.json && node host/build.mjs",
    "host:package": "pnpm run host:build && node host/package.mjs",
    "host": "node build/host/monocode-host.mjs",
    "pretest:host": "pnpm run host:build",
    "test:host": "vitest run --config host/vitest.config.ts",
    "check": "pnpm run check:web && pnpm run check:rust",
    "check:web": "vitest run && tsc --noEmit",
    "check:rust": "cargo fmt --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test",
    "set-version": "node scripts/bump-version.mjs",
    "tauri": "tauri",
    "tauri:stable": "tauri dev --no-watch --config src-tauri/tauri.stable.conf.json",
    "setup:linux:deb": "bash scripts/install-linux-deps-debian.sh",
    "setup:linux:fedora": "bash scripts/install-linux-deps-fedora.sh",
    "build:linux": "tauri build --bundles deb,appimage",
    "build:fedora": "tauri build --bundles rpm",
    "build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.8",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@lezer/common": "1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/mermaid": "^1.0.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "cuelume": "^0.2.2",
    "dompurify": "^3.4.16",
    "mammoth": "^1.13.0",
    "mermaid": "11.16.1",
    "pdfjs-dist": "^6.3.289",
    "prettier": "^3.9.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-material-icon-theme": "^1.2.0",
    "rehype-harden": "^1.1.8",
    "shiki": "^3.23.0",
    "streamdown": "^2.5.0",
    "unified": "11.0.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2",
    "@types/hast": "3.0.5",
    "@types/node": "26.5.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "esbuild": "0.28.2",
    "happy-dom": "20.14.0",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
}
